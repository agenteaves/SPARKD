# Local console defaults to demo mode. Copy to .env to customize.
PORT=4173
SPARKD_MINT=BMU2rhUtANRS1hYKC1pQgxjcJ2Pn9PQURcf8CcRVpump
# Set this to the exact SPARKD fee in smallest token units after confirming mint decimals.
SPARKD_FEE_BASE_UNITS=1000000
SPARKD_FEE_RECEIVER=

# Pimlico's Kora-compatible Devnet endpoint. Create a Pimlico API key and put it in this URL.
# Devnet sponsorship is free; never expose the key in browser code or commit the real key.
KORA_RPC_URL=https://solana.pimlico.io/v1/devnet/rpc?apikey=YOUR_API_KEY
KORA_API_KEY=

# Devnet-only integration checks (the app's test fee mint is separate from production SPARKD).
DEVNET_RPC_URL=https://api.devnet.solana.com
SPARKD_DEVNET_MINT=
SPARKD_DEVNET_FEE_BASE_UNITS=1000000
RAYDIUM_DEVNET_POOL_ID=8qafQAbCZnzUuBkv5zBjxADpK8UHjSBpAJTK2nSmB5Z4
RAYDIUM_DEVNET_API=https://api-v3-devnet.raydium.io
