# Local console defaults to demo mode. Copy to .env to customize.
PORT=4173
SPARKD_MINT=BMU2rhUtANRS1hYKC1pQgxjcJ2Pn9PQURcf8CcRVpump
# Set this to the exact SPARKD fee in smallest token units after confirming mint decimals.
SPARKD_FEE_BASE_UNITS=1000000
SPARKD_FEE_RECEIVER=

# Optional Kora endpoint used by the app's server-side fee sponsor.
# Never place signer private keys in browser code or commit them here.
KORA_RPC_URL=
KORA_API_KEY=

# Devnet-only integration checks (a test mint is separate from production SPARKD).
DEVNET_RPC_URL=https://api.devnet.solana.com
SPARKD_DEVNET_MINT=
RAYDIUM_DEVNET_POOL_ID=8qafQAbCZnzUuBkv5zBjxADpK8UHjSBpAJTK2nSmB5Z4
RAYDIUM_DEVNET_API=https://api-v3-devnet.raydium.io
